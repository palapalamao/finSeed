// One entry in FIN's native application launcher. Authentication stays in FIN.
---
name: enerCubixApp
finStackMobileMenu
func
overridable
doc: "EnergyCubix building energy analytics"
src:
  () => do
    rootUri: enerCubixAppUri()
    [{
      displayName: toLocale("enerCubix::enerCubixMenuGroup"),
      appId: "",
      isDivider: true,
      level: 0,
      order: -20,
      ui: "mobile"
    }, {
      displayName: toLocale("enerCubix::enerCubixApp"),
      appId: "enerCubixApp",
      link: "",
      icon: "enercubix-launcher-cube",
      iconType: "class",
      ui: "mobile",
      minUiTarget: "phone",
      order: -19,
      action: "top.app.LoadApplication('" + rootUri + "', null, null, {app: '_enerCubix'});top.app.ToggleCollapse(true);",
      keepOpen: true
    }].toGrid
  end
---
name: enerCubixMobileSettings
func
stackMobileSettings
doc: "Register the EnergyCubix native launcher icon styles"
src:
  () => {styles: ["/pod/enerCubix/res/enercubix-launcher.css"]}
---
