// One entry in FIN's native application launcher. Authentication stays in FIN.
---
name: enerCubixApp
finStackMobileMenu
func
overridable
doc: "EnerCubix energy workspace"
src:
  () => do
    rootUri: enerCubixAppUri()
    [{
      displayName: "能源魔方 / EnerCubix",
      appId: "enerCubixApp",
      link: "",
      icon: "icon-graph-line",
      iconType: "class",
      ui: "mobile",
      minUiTarget: "phone",
      order: -1,
      action: "top.app.LoadApplication('" + rootUri + "', null, null, {app: '_enerCubix'});top.app.ToggleCollapse(true);",
      keepOpen: true
    }].toGrid
  end
---
